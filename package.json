{
  "name": "chatsync",
  "version": "1.0.0",
  "description": "Lightweight browser extension + backend service to organize and sync AI chatbot histories",
  "main": "backend/main.py",
  "scripts": {
    "start": "cd backend && python start.py",
    "install-deps": "cd backend && pip install -r requirements.txt",
    "dev": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000"
  },
  "keywords": [
    "ai",
    "chatgpt", 
    "claude",
    "perplexity",
    "browser-extension",
    "chat-history",
    "sync"
  ],
  "author": "ChatSync Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/chatsync.git"
  },
  "directories": {
    "extension": "./extension",
    "backend": "./backend"
  }
}
